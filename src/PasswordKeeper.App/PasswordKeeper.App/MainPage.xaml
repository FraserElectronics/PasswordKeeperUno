<Page x:Class="PasswordKeeper.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid>
    <!-- Unlock / create -->
    <Grid x:Name="UnlockPanel">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0B1B33" Offset="0" />
          <GradientStop Color="#16356B" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="380" Padding="28" CornerRadius="16" Margin="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <StackPanel Spacing="12">
            <!-- Shield logo -->
            <Viewbox Width="96" Height="96" HorizontalAlignment="Center">
              <Canvas Width="120" Height="124">
                <Path Data="M60,8 L104,24 V62 C104,88 84,106 60,116 C36,106 16,88 16,62 V24 Z">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#2DD4BF" Offset="0" />
                      <GradientStop Color="#0EA5E9" Offset="1" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <Ellipse Canvas.Left="44" Canvas.Top="42" Width="32" Height="32" Fill="#0B1B33" />
                <Path Data="M54,70 L66,70 L70,94 L50,94 Z" Fill="#0B1B33" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="PasswordKeeper" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="UnlockHint" TextWrapping="Wrap" Opacity="0.8" />
            <PasswordBox x:Name="MasterBox" PlaceholderText="Master password" PasswordChanged="OnMasterChanged" KeyDown="OnMasterKeyDown" />
            <PasswordBox x:Name="ConfirmBox" PlaceholderText="Confirm master password" Visibility="Collapsed" PasswordChanged="OnMasterChanged" KeyDown="OnMasterKeyDown" />
            <CheckBox x:Name="ShowMasterCheck" Content="Show password" Checked="OnShowMasterChanged" Unchecked="OnShowMasterChanged" />
            <TextBlock x:Name="MatchText" Opacity="0.7" />
            <Button x:Name="UnlockButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnUnlockClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Permissions" />
                <TextBlock x:Name="UnlockButtonText" Text="Unlock" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="UnlockError" Foreground="Red" TextWrapping="Wrap" />
            <TextBlock x:Name="PathText" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Click="OnOpenVaultClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <SymbolIcon Symbol="OpenFile" />
                  <TextBlock Text="Open vault..." />
                </StackPanel>
              </Button>
              <Button Click="OnNewVaultClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <SymbolIcon Symbol="Add" />
                  <TextBlock Text="New vault..." />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <!-- Vault -->
    <Grid x:Name="VaultPanel" Visibility="Collapsed" Padding="16" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Viewbox Width="32" Height="32">
            <Canvas Width="120" Height="124">
              <Path Data="M60,8 L104,24 V62 C104,88 84,106 60,116 C36,106 16,88 16,62 V24 Z">
                <Path.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2DD4BF" Offset="0" />
                    <GradientStop Color="#0EA5E9" Offset="1" />
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <Ellipse Canvas.Left="44" Canvas.Top="42" Width="32" Height="32" Fill="#0B1B33" />
              <Path Data="M54,70 L66,70 L70,94 L50,94 Z" Fill="#0B1B33" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="PasswordKeeper" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <SymbolIcon Symbol="Find" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search" TextChanged="OnSearchChanged" />
        </Grid>

        <ListView x:Name="EntryList" Grid.Row="2" DisplayMemberPath="Title" SelectionChanged="OnEntrySelected" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
          <Button Click="OnNewClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Add" />
              <TextBlock Text="New entry" />
            </StackPanel>
          </Button>
          <Button Click="OnLockClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="ProtectedDocument" />
              <TextBlock Text="Lock" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="8">
          <Button HorizontalAlignment="Stretch" Click="OnChangeMasterClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Setting" />
              <TextBlock Text="Change master password..." />
            </StackPanel>
          </Button>
          <Button HorizontalAlignment="Stretch" Click="OnImportClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Import" />
              <TextBlock Text="Import CSV..." />
            </StackPanel>
          </Button>
          <Button HorizontalAlignment="Stretch" Click="OnExportClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Upload" />
              <TextBlock Text="Export CSV..." />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Column="1">
        <StackPanel x:Name="EditorPanel" Spacing="10">
          <TextBox x:Name="TitleBox" Header="Title" />
          <TextBox x:Name="UrlBox" Header="URL" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserBox" Header="Username" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnCopyUserClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Copy" />
                <TextBlock Text="Copy" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PassBox" Header="Password" PasswordRevealMode="Peek" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnGenerateClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Refresh" />
                <TextBlock Text="Generate" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnCopyPassClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Copy" />
                <TextBlock Text="Copy" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SaveButton" Click="OnSaveClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Save" />
                <TextBlock Text="Save" />
              </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Click="OnDeleteClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Delete" />
                <TextBlock Text="Delete" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
